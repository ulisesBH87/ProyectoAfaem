<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Módulo de Reescritura de URL (URL Rewrite) de IIS -->
    <rewrite>
      <rules>

        <!-- ============================================================ -->
        <!-- REGLA 1: Proxy inverso para el Backend FastAPI (puerto 8000) -->
        <!-- Mapea /afaem/api/* → http://localhost:8000/*                 -->
        <!-- Cubre: auth, solicitud, catalogos, equipo, gestion, etc.     -->
        <!-- ============================================================ -->
        <rule name="ReverseProxyToBackend" stopProcessing="true">
          <match url="^api/(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://localhost:8000/{R:1}" />
        </rule>

        <!--
        <rule name="ReverseProxyToOCR" stopProcessing="true">
          <match url=".*ocr-api/?(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://localhost:5001/{R:1}" />
        </rule>
        -->

        <!-- ============================================================ -->
        <!-- REGLA 3: SPA Fallback para React Router                      -->
        <!-- Redirige cualquier ruta no encontrada al index.html          -->
        <!-- Esto es necesario para que las rutas de React funcionen      -->
        <!-- al recargar la página o navegar directamente a una URL       -->
        <!-- ============================================================ -->
        <rule name="ReactRouterFallback" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>

      </rules>
    </rewrite>

    <!-- Evitar que IIS muestre sus propios mensajes de error -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
